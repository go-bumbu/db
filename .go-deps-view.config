# go-deps-view config for github.com/go-bumbu/db. YAML, read on each request
# (reload the page after an edit). Keys: flatten, layers (name, description,
# entrypoint, packages), hidden, support.
#
# Every package lives under gormdb/, so the bands are made of what that folder
# holds and its box spans them. Layers never split a folder box, so flatten
# dissolves gormdb/internal, letting sqliteerr and sqlitetest sit in different
# layers.

flatten: [gormdb/internal]

layers:
  - name: Drivers
    description: Database drivers built on the core
    packages:
      - gormdb/sqlite
      - gormdb/sqlitecgo
      - gormdb/postgres

  - name: Core
    description: GORM foundation, config and driver interfaces
    packages: [gormdb, "*"]

  - name: Internal
    description: Helpers shared by the SQLite drivers
    packages: [gormdb/internal/sqliteerr]

  - name: Test helpers
    packages:
      - gormdb/gormdbtest
      - gormdb/internal/sqlitetest

support:
  - gormdb/gormdbtest
  - gormdb/internal/sqlitetest

# Start the support packages toggled off: greyed out, without arrows, until clicked
# or "show all". Unchecking "support packages" removes them from the layout instead.
hidden:
  - gormdb/gormdbtest
  - gormdb/internal/sqlitetest
